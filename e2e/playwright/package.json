{
  "name": "mattermost-plugin-gitlab-e2e",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "PW_HEADLESS=false playwright test",
    "test:ui": "playwright test --ui",
    "show-report": "playwright show-report results/reporter",
    "server:up": "docker compose up -d --wait",
    "server:down": "docker compose down -v",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@mattermost/client": "11.3.0",
    "@mattermost/playwright-lib": "11.4.0",
    "@mattermost/types": "11.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
